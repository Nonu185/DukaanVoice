# ─────────────────────────────────────────────────────────────────────────────
# DukaanVoice AI — Backend Environment Configuration
# Copy this file to server/.env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Server Port (default: 5000)
PORT=5000

# Environment Mode: 'development' or 'production' (Required: drives cookie security, CORS, and logging)
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example: mongodb://localhost:27017/dukaanvoice
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dukaanvoice?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/dukaanvoice

# Allowed Frontend URL for CORS (with credentials)
CLIENT_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# JWT Authentication & Cookie Configuration
# JWT is stored strictly in HTTP-only cookies (dvai.token), NEVER in localStorage.
# ─────────────────────────────────────────────────────────────────────────────

# JWT Secret Key (generate via: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# JWT Token Expiry (7 days)
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# Gnani AI Indic Foundation Models
# ─────────────────────────────────────────────────────────────────────────────

# 1. Unified Gnani API Key for Speech Services:
# Powers both Prisma v2.5 (Speech-to-Text) and Timbre v2.5 (Text-to-Speech)
# Obtain from https://gnani.ai or https://vachana.ai
GNANI_API_KEY=your_gnani_unified_api_key

# Optional custom base URLs for speech services (defaults to official Gnani endpoints):
GNANI_PRISMA_BASE_URL=https://api.vachana.ai/stt/v3
GNANI_TIMBRE_BASE_URL=https://api.vachana.ai/api/v1/tts/inference

# 2. Google Gemini Dynamic NLU Engine (@google/genai):
# Powers multilingual intent extraction and context-aware conversation understanding.
# Obtain from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
